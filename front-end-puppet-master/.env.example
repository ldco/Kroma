# Kroma Frontend Environment Variables

# PM Mode - Controls setup wizard behavior
# - 'unconfigured': Shows /init setup wizard (default for fresh PM clones)
# - 'build': Configured for client project (Kroma uses this)
# - 'develop': Framework development mode with showcase
PM_MODE=build

# Backend API URL
KROMA_API_BASE_URL=http://127.0.0.1:8788
